# .env.example — NAMES ONLY. Never put a real credential in this file; it is
# tracked in git (.gitignore un-ignores it).
#
# Local setup:
#   npx vercel env pull .env.local     # preferred — values already live in Vercel
#   cp .env.example .env.local         # or fill it in by hand
#
# `.env.local` is git-ignored. Everything below is read at runtime only.

# --- Supabase ----------------------------------------------------------------
# Without these, sendMessage() still renders and still picks a transport, but
# nothing is written to `messages` or `order_events` and it says so in the log.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Twilio: the vendor SMS channel ------------------------------------------
# specs/00-contracts.md "Comms transport". Set the account pair plus ONE sender.
# A Messaging Service SID wins when both senders are present.
# Trial-account limits: wiki/facts/sms-delivery-constraints.md.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# --- Resend: family notices and the demo fallback ----------------------------
# RESEND_FROM is optional; it defaults to Resend's shared onboarding sender,
# which only delivers to the address that owns the API key.
RESEND_API_KEY=
RESEND_FROM=

# --- LLM providers -----------------------------------------------------------
# parseVendorReply() falls back to the LLM pass only when a key is present.
# Without one the regex baseline runs alone, and `npm run eval:parse` prints
# n/a for the hybrid column rather than an invented number.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Toggles -----------------------------------------------------------------
# MESSAGING_DRY_RUN=1 makes sendMessage() render the message, pick a transport,
# log both, then send nothing and write nothing. Use it to exercise the comms
# path without credentials or spend. Leave it unset for the demo.
MESSAGING_DRY_RUN=
NEXT_PUBLIC_DEMO_SEED=1
