# .env.example — DO NOT COMMIT SECRETS
# Copy to .env.local for local development and fill in secrets.

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# LLM providers
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Resend (email/sms fallback)
RESEND_API_KEY=

# Twilio (already expected in Production+Development)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Optional development toggles
NEXT_PUBLIC_DEMO_SEED=1
