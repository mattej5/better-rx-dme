{
  "_convention": {
    "purpose": "Fixtures for npm run eval:parse (specs/engine.md §6). Each case is run twice: regex-only (the baseline) and the full hybrid parser. The file is committed, so every value here is fixed — nothing is derived from the current date.",
    "shape": "{ id, group, message, orderContext, expected: { intent, eta?, minConfidence } }",
    "groups": {
      "structured": "8 cases the regex pass should handle at zero cost.",
      "messy": "10 cases where the LLM pass should beat regex.",
      "adversarial": "6 cases that test restraint. A high-confidence wrong answer here is worse than an honest unknown."
    },
    "intent": "One of 'confirm' | 'decline' | 'eta' | 'delay' | 'question' | 'unknown' (specs/engine.md §3.4). No other values exist.",
    "eta": "Two forms, one convention. ABSOLUTE: an ISO 8601 timestamp with the America/Denver offset (-06:00, MDT in August), on the same calendar date as orderContext.neededBy unless the message names a different day. Used when the message states a clock time. RELATIVE: a marker of the form +Nm or +Nh, meaning N minutes or N hours after the moment the reply is received. Used when the message states a duration. Absolute times get a +/-5 minute match tolerance.",
    "etaAbsent": "No eta key means no ETA should be extracted. A parse that invents a time fails the case, even if the intent is right. This applies to messages that name a day but no time (messy/bed-other-truck, messy/o2-hazmat-monday).",
    "minConfidence": "The floor a parse must clear to count as a pass, 0 to 1. The runtime action gate is 0.75 (specs/engine.md §3.4): below it, no state change, the parse goes to the nurse as 'we read this as X, please confirm'. Cases where the vendor stated something plainly are floored at or above that gate. Genuinely hedged messages are floored below it — the correct intent at honest low confidence is a pass, because routing to a human is the right outcome.",
    "minConfidenceZero": "Every case expecting 'unknown' has minConfidence 0. The test is not that the parser is confident, it is that it does not confidently return anything else. A high-confidence non-unknown result on these six is a FAIL.",
    "timezone": "America/Denver everywhere — single hospice timezone, pinned in specs/engine.md §7.4.",
    "data": "Synthetic. Order numbers are a dedicated DME-204xx eval range and do not collide with the seeded demo orders. Vendor names match the seed roster in specs/data.md. No real patients, vendors, or addresses.",
    "count": 24
  },
